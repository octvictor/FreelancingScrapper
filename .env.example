# Copy this file to .env and fill in your own values (or use the app's
# Settings tab instead). .env is git-ignored.

LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Run browsers with a visible window (recommended: True). Needed so you can
# solve login checkpoints / 2FA / CAPTCHAs by hand when they show up.
BROWSER_HEADLESS=False

# Seconds to sleep between page actions (min,max). Keep this conservative -
# it's your main defense against getting rate-limited or flagged.
SCRAPE_DELAY_MIN=2.0
SCRAPE_DELAY_MAX=5.0

# When true, every scraper returns realistic fake sample data instead of
# touching LinkedIn/Instagram/Behance - lets you click through the whole
# app safely, with no real login and no risk to your accounts. The app's
# sidebar also has a toggle for this that overrides it per-session.
MOCK_MODE=True
